{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "CANCELLED"
      ]
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "decision": {
            "enum": [
              "keep",
              "review-later",
              "skip",
              "mark-reviewed"
            ]
          },
          "note": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "decision",
          "note",
          "updated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "status",
    "decisions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-state.schema.json"
}
